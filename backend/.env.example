# Copy to backend/.env and fill secrets. .env is gitignored; .env.example is not.

APP_NAME="Lenta Price-Tag Gateway"
DEBUG=true
# true = routes return mock data, no Postgres/Redis/ML needed. Flip per layer.
MOCK_MODE=true
ALLOWED_ORIGINS='["http://localhost:5173"]'

# Postgres (used once persistence is implemented)
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Auth secrets (documented in docs/architecture.md §3.8 — generate real ones)
JWT_SECRET_KEY=replace-with-a-long-random-string
CSRF_SECRET_KEY=replace-with-another-long-random-string

# ML inference service
ML_BASE_URL=http://ml:8002
ML_TIMEOUT_SECONDS=600
