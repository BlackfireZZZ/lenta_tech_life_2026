# Copy to backend/.env and fill secrets. .env is gitignored; .env.example is
# not. With docker-compose this file is OPTIONAL — compose sets every value
# the real path needs (env_file is `required: false`). Use it for local
# non-docker runs or to override compose.

APP_NAME="Lenta Price-Tag Gateway"
DEBUG=true
# false = the real product: jobs persist in Postgres and the gateway calls
# the real ml service. true = standalone skeleton (in-memory mock, no
# Postgres/Redis/ML) — handy for frontend-only work.
MOCK_MODE=false
ALLOWED_ORIGINS='["http://localhost:5173"]'

# Shared video handoff dir — must equal the `uploads` volume mount that both
# `backend` and `ml` see (docker-compose.yaml).
UPLOAD_ROOT=/data/uploads

# Postgres
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres

# Redis (status-read cache; fail-open — Redis down ⇒ transparent passthrough)
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_ENABLED=true

# Auth secrets (documented in docs/architecture.md §3.8 — generate real ones)
JWT_SECRET_KEY=replace-with-a-long-random-string
CSRF_SECRET_KEY=replace-with-another-long-random-string

# ML inference service
ML_BASE_URL=http://ml:8002
ML_TIMEOUT_SECONDS=600
